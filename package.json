{
	"name": "@osdiab-website/monorepo",
	"private": true,
	"scripts": {
		"build": "pnpm --recursive run build",
		"dev": "pnpm --recursive run dev",
		"lint:eslint:base": "eslint \"./**/*.{ts,js,tsx,jsx}\"",
		"lint:eslint:fix": "pnpm lint:eslint:base --fix",
		"lint:biome:base": "biome lint .",
		"lint:biome:fix": "biome check --apply-unsafe .",
		"lint": "pnpm run '/^lint:.*:base$/'",
		"lint:fix": "pnpm run --workspace-concurrency=1 '/^lint:.*:fix$/'",
		"format:base": "biome format .",
		"format": "pnpm format:base --write",
		"format:check": "pnpm format:base --check",
		"test": "pnpm --recursive run test",
		"typecheck": "tsc --project"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.7.0",
		"@osdiab-website/tsconfig": "workspace:*",
		"@typescript-eslint/eslint-plugin": "^7.7.0",
		"@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-qwik": "^1.5.2",
		"typescript": "5.4.5"
	}
}
